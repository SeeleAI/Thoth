{
  "name": "@thoth/drivers",
  "version": "0.0.0-mvp-beta",
  "private": true,
  "description": "Harness driver adapters for Thoth",
  "license": "AGPL-3.0-or-later",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./clarify": {
      "types": "./dist/clarify/index.d.ts",
      "default": "./dist/clarify/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime.d.ts",
      "default": "./dist/agent-runtime.js"
    },
    "./provider-usage": {
      "types": "./dist/provider-usage/index.d.ts",
      "default": "./dist/provider-usage/index.js"
    },
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json --incremental false && node scripts/copy-runtime-skills.mjs",
    "build:clean": "npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:thoth:transports": "vitest run src/harness/provider-transport-contract.test.ts src/server/agent/providers",
    "eval:clarify": "node dist/clarify/eval.js"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.17.1",
    "@anthropic-ai/claude-agent-sdk": "^0.3.195",
    "@opencode-ai/sdk": "1.14.46",
    "@thoth/protocol": "0.0.0-mvp-beta",
    "p-limit": "^7.3.0",
    "pino": "^10.2.0",
    "tree-kill": "^1.2.2",
    "which": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  }
}
