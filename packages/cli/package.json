{
  "name": "@thoth/cli",
  "version": "0.0.0-mvp-beta",
  "private": true,
  "description": "Thoth CLI - control your AI coding agents from the command line",
  "license": "AGPL-3.0-or-later",
  "bin": {
    "thoth": "bin/thoth"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "test": "npm run test:local",
    "test:local": "tsx tests/run-all.ts",
    "test:e2e": "npm run test:local",
    "test:e2e:lifecycle": "npx tsx tests/e2e/agent-lifecycle.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@thoth/client": "0.0.0-mvp-beta",
    "@thoth/daemon": "0.0.0-mvp-beta",
    "@thoth/protocol": "0.0.0-mvp-beta",
    "@thoth/tui": "0.0.0-mvp-beta",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "mime-types": "^2.1.35",
    "ws": "^8.14.2",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
